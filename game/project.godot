; Packet Quest: La Red Rota / Godot 4.7.2
config_version=5

[application]
config/name="Packet Quest: La Red Rota"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Events="*res://scripts/autoload/events.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02745, 0.04314, 0.0902, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_bullet"
2d_physics/layer_5="enemy_bullet"
2d_physics/layer_6="interactable"
2d_physics/layer_7="hazard"
2d_physics/layer_8="shield"

[input]
ui_accept={"deadzone":0.5,"events":[Object(InputEventKey,"keycode":4194309),Object(InputEventKey,"keycode":4194310),Object(InputEventKey,"keycode":32),Object(InputEventJoypadButton,"device":-1,"button_index":0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadButton,"button_index":13),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1)]}

move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadButton,"button_index":14),Object(InputEventJoypadMotion,"axis":0,"axis_value":1)]}

aim_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1)]}

aim_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":1,"axis_value":1)]}

jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventKey,"physical_keycode":90),Object(InputEventJoypadButton,"button_index":0)]}

shoot={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventKey,"physical_keycode":88),Object(InputEventJoypadButton,"button_index":2)]}

dash={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventKey,"physical_keycode":4194325),Object(InputEventJoypadButton,"button_index":1)]}

shield={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76),Object(InputEventKey,"physical_keycode":67),Object(InputEventJoypadButton,"button_index":9)]}

lock_aim={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73),Object(InputEventKey,"physical_keycode":86),Object(InputEventJoypadButton,"button_index":10)]}

interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":3)]}

swap_weapon={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":4)]}

pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
